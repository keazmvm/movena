{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Movena E2E",
  "identifier": "com.movena.desktop.e2e",
  "build": {
    "beforeBuildCommand": "npm run build:desktop-e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "e2e",
          "description": "WebDriver permissions compiled only into the desktop E2E build",
          "windows": ["main"],
          "permissions": ["wdio:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": false
  }
}
