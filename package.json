{
  "name": "movena",
  "private": true,
  "version": "0.1.1",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "vite-dev": "vite",
    "dev": "npm run setup:mpv && tauri dev",
    "setup:mpv": "node scripts/ensure-windows-mpv.mjs",
    "build": "tsc -b && vite build",
    "build:msix": "powershell -ExecutionPolicy Bypass -File scripts/make-msix.ps1",
    "typecheck": "tsc -b",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm run test:coverage && npm run test:rust",
    "design:check": "node scripts/check-design-system.mjs",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "cargo-check": "cd src-tauri && cargo check",
    "clean:rust-stale": "cd src-tauri && cargo sweep --time 14",
    "clean:rust": "cd src-tauri && cargo clean",
    "check": "npm run design:check && npm run format:rust:check && npm run typecheck && npm run typecheck:test && npm run test:all && npm run cargo-check",
    "tauri": "tauri",
    "preview": "vite preview",
    "licenses:generate": "node scripts/generate-third-party-licenses.mjs",
    "licenses:check": "node scripts/generate-third-party-licenses.mjs --check",
    "public-tree:check": "node scripts/check-public-tree.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "country-flag-icons": "^1.6.20",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
